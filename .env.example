WEATHER_API_KEY=your_weather_api_key

# Required for writing all saved data to Firestore through Firebase Admin SDK.
# Recommended local setup:
# 1. Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# 2. Convert the downloaded JSON to base64.
# 3. Paste it here as one line.
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Alternative: use a one-line JSON string instead of base64.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Production should verify Firebase ID tokens with Admin SDK.
# Keep this false/omitted in local dev only if you intentionally want auth fallback.
DISABLE_DEV_AUTH_FALLBACK=true
NODE_ENV=development
PORT=7860

# Comma-separated exact frontend origins. Set the deployed staging origin on
# the staging platform; do not use a wildcard for authenticated APIs.
URBANAGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Request-time destination search remains disabled while these values are empty.
# Staging must use an explicitly approved HTTPS endpoint and exact hostname;
# never put a provider secret in a frontend VITE_* variable.
URBANAGENT_GEOCODER_URL=
URBANAGENT_GEOCODER_ALLOWED_HOSTS=
URBANAGENT_GEOCODER_RATE_LIMIT_PER_MINUTE=30

# Primary request-time Places API (New) and Geocoding API key. Keep this
# server-side, restrict it to the two APIs, and apply server/IP restrictions.
# When empty, UrbanAgent keeps canonical/Photon/manual-pin fallbacks and never
# claims that an approximate address is exact.
GOOGLE_MAPS_SERVER_API_KEY=
