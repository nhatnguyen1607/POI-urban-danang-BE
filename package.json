{
  "name": "back-end",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "generate:synthetic": "node scripts/generate_synthetic_dataset.js",
    "evaluate:agent": "node scripts/evaluate_agent.js",
    "build:memory": "node scripts/build_agent_memory.js",
    "train:reranker": "node scripts/train_reranker.js",
    "train:agent-runtime": "npm run build:memory && npm run train:reranker && npm run evaluate:learning && npm run visualize:evaluation",
    "functions:build": "npm --prefix functions run build",
    "emulators:start": "npx --yes firebase-tools emulators:start --project demo-poi-urban --only functions,firestore",
    "emulators:verify-learning": "npx --yes firebase-tools emulators:exec --project demo-poi-urban --only functions,firestore \"node scripts/verify_online_learning_emulator.js\"",
    "export:representation-data": "node scripts/export_representation_training_data.js",
    "visualize:evaluation": "node scripts/visualize_agent_evaluation.js",
    "research:agent": "npm run generate:synthetic && npm run export:representation-data && npm run evaluate:learning && npm run visualize:evaluation",
    "evaluate:learning": "node scripts/evaluate_learning_loop.js",
    "phase1:db:diagnostics": "node scripts/phase1_db_diagnostics.js",
    "phase1:db:migrate": "node scripts/phase1_db_migrate.js",
    "phase1:db:rollback": "node scripts/phase1_db_rollback.js",
    "phase1:import:canonical": "node scripts/phase1_import_canonical_pois.js",
    "citypack:sync": "node scripts/citypack_sync.js",
    "citypack:auto-pr": "node scripts/citypack_auto_pr.js",
    "citypack:scheduled-sync": "node scripts/citypack_scheduled_sync.js",
    "citypack:scheduled-runner": "node scripts/citypack_scheduled_runner.js",
    "citypack:self-test": "node scripts/citypack_scheduled_runner.js --self-test",
    "citypack:health": "node scripts/citypack_scheduled_runner.js --health",
    "citypack:create-new-research": "node --max-old-space-size=4096 scripts/phase4_stage4p_create_new_policy_research.js",
    "citypack:create-new-evidence": "node --max-old-space-size=4096 scripts/phase4_stage4q_create_new_evidence.js",
    "citypack:create-new-canary-review": "node --max-old-space-size=4096 scripts/phase4_stage4r_create_new_canary_review.js",
    "citypack:create-new-canary-apply": "node --max-old-space-size=4096 scripts/phase4_stage4s_controlled_create_new_canary.js",
    "test": "node --test tests/phase0/*.test.js tests/phase1/*.test.js tests/phase2/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "multer": "^2.2.0",
    "pg": "^8.13.1"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "call-bind-apply-helpers": "1.0.2",
    "form-data": "2.5.6",
    "get-intrinsic": "1.3.0",
    "hasown": "2.0.4",
    "protobufjs": "7.6.5",
    "qs": "6.15.3",
    "uuid": "11.1.1"
  }
}
